rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // PalBook Live - Storage Security Rules
    // Created by T. Wad Refae
    //
    // - Anyone can read lesson files (they are served via iframe in the app)
    // - Only authenticated teachers can upload/delete lesson files

    match /lessons/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
  }
}
