rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------
    // PalBook Live - Firestore Security Rules
    // Created by T. Wad Refae
    // ----------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Users collection
    // - A user can read/write their own profile
    // - Teachers can read all user profiles (to see student list)
    // - A user can never hand themselves the teacher role: sign-up is always
    //   a student, and an update must keep the role it already has. Promoting
    //   an account to teacher is done from the Firebase console.
    match /users/{userId} {
      allow read: if isSignedIn()
                  && (request.auth.uid == userId || isTeacher());
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'student';
      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
      allow delete: if false; // never allow user deletion from client
    }

    // Lessons collection
    // - Anyone can read lessons (public)
    // - Only teachers can create/update/delete lessons
    match /lessons/{lessonId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    // Shop catalogue
    // - Anyone can browse products (titles, prices, file names)
    // - The files themselves are guarded by the Storage rules
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    // Orders
    // - A buyer may only create their own order, and only as `pending`:
    //   confirming a payment is the teacher's decision alone
    // - A buyer can read their own orders; the teacher reads them all
    match /orders/{orderId} {
      allow get: if isSignedIn()
                 && (resource.data.uid == request.auth.uid || isTeacher());
      allow list: if isSignedIn()
                  && (resource.data.uid == request.auth.uid || isTeacher());
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if isTeacher();
    }

    // Entitlements — the proof of purchase that unlocks a product.
    // Written by the teacher when confirming a payment, never by a buyer.
    // The document id is `<uid>_<productId>`.
    match /entitlements/{entitlementId} {
      // A `get` on a document that does not exist evaluates with resource == null;
      // the buyer is allowed to learn that they simply own nothing yet.
      allow get: if isSignedIn()
                 && (resource == null
                     || resource.data.uid == request.auth.uid
                     || isTeacher());
      allow list: if isSignedIn()
                  && (resource.data.uid == request.auth.uid || isTeacher());
      allow create, update, delete: if isTeacher();
    }

    // Shop settings (iBuraq payment details shown at checkout)
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }
  }
}
